{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.exoiteitservices.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://exoiteitservices.com/$1"
      }
    },
    {
      "src": "/(.+)/",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(about|services|products|portfolio|training|contact|insights|services/website-development|services/custom-software-development|services/mobile-app-development|services/school-institute-solutions|services/digital-marketing|services/it-training|services/ai-automation|services/ai-chatbots|services/ai-workflow-integration|services/ai-business-software|portfolio/examify|portfolio/inventory-management|portfolio/learning-management-system|insights/choosing-a-business-website|insights/school-website-development-considerations|insights/when-a-business-needs-custom-software|privacy-policy|terms-of-service)\\.html$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(about|services|products|portfolio|training|contact|insights|services/website-development|services/custom-software-development|services/mobile-app-development|services/school-institute-solutions|services/digital-marketing|services/it-training|services/ai-automation|services/ai-chatbots|services/ai-workflow-integration|services/ai-business-software|portfolio/examify|portfolio/inventory-management|portfolio/learning-management-system|insights/choosing-a-business-website|insights/school-website-development-considerations|insights/when-a-business-needs-custom-software|privacy-policy|terms-of-service)$",
      "dest": "/$1.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
